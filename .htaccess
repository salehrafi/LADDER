# Apache rules for shared hosting (InfinityFree and similar).
# The whole project lives inside the public web folder, so keep secrets and
# internal code out of reach of visitors.

Options -Indexes

# Secrets, version control, docs and internal folders: never served.
# mod_alias works even where mod_rewrite is unavailable.
<IfModule mod_alias.c>
    RedirectMatch 403 (?i)/\.(env|git|aider)
    RedirectMatch 403 (?i)/(db|includes|vendor|PHPMailer|tests|docs)(/|$)
    RedirectMatch 403 (?i)\.(md|lock|json|sql|log|ini|bak)$
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule (^|/)\.(env|git|aider) - [F,L]
    RewriteRule ^(db|includes|vendor|PHPMailer|tests|docs)(/|$) - [F,L]
    RewriteRule \.(md|lock|json|sql|log|ini|bak)$ - [F,L,NC]
</IfModule>
